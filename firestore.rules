rules_version = '2';

// Mağaza Raporu — Firestore güvenlik kuralları
//
// rapor.html anonim girişle çalışır. Kullandığı yollar:
//   settings/{belge}                 — profil listesi
//   stores/{magaza}/{alt yollar}     — mağazanın bütün verisi
//   entries, weekgoals, tools, ghbhr* — mağaza ayrımından önceki eski kayıtlar

service cloud.firestore {
  match /databases/{database}/documents {

    function girisli(){ return request.auth != null; }

    match /settings/{belge}     { allow read, write: if girisli(); }
    match /stores/{magaza}/{belge=**} { allow read, write: if girisli(); }

    // Mağaza ayrımından önce köke yazılmış eski veriler.
    match /entries/{belge}      { allow read, write: if girisli(); }
    match /weekgoals/{belge}    { allow read, write: if girisli(); }
    match /tools/{belge}        { allow read, write: if girisli(); }
    match /ghbhrWeekly/{belge}  { allow read, write: if girisli(); }
    match /ghbhrReports/{belge} { allow read, write: if girisli(); }
  }
}
