rules_version = '2';

// Mağaza Raporu — Firestore güvenlik kuralları
//
// Giriş Firebase Authentication e-posta/şifre ile yapılır:
// kullanıcı adı "m583" → e-posta "m583@mcrapor.app".
// Kimin neye erişeceği yetkiler/{kullaniciAdi} belgesinde durur:
//   { rol: "magaza" }                          — yalnızca stores/{kullaniciAdi}
//   { rol: "bolge", magazalar: ["m583", ...] } — listedeki mağazalar (okur ve düzeltir)
// Yetki belgelerini Firebase Console'dan siz açarsınız. Bölge müdürü yalnızca
// kendi belgesindeki "magazalar" listesini değiştirebilir, rolünü değiştiremez.

service cloud.firestore {
  match /databases/{database}/documents {

    function girisli(){
      return request.auth != null && request.auth.token.email is string
          && request.auth.token.email.matches('.+@mcrapor[.]app');
    }
    function kadi(){ return request.auth.token.email.lower().split('@')[0]; }
    function yetkiVar(){ return exists(/databases/$(database)/documents/yetkiler/$(kadi())); }
    function yetki(){ return get(/databases/$(database)/documents/yetkiler/$(kadi())).data; }

    function magazaErisimi(m){
      return girisli() && yetkiVar() && (
        (yetki().rol == 'magaza' && kadi() == m) ||
        (yetki().rol == 'bolge' && yetki().magazalar is list && m in yetki().magazalar)
      );
    }

    // Eski "onur" profilinin verisini m583'e taşımak için yalnızca okuma izni.
    function eskiVeriSahibi(){ return girisli() && kadi() == 'm583'; }

    match /yetkiler/{k} {
      allow read: if girisli() && (k == kadi() || (yetkiVar() && yetki().rol == 'bolge'));
      allow update: if girisli() && k == kadi() && yetkiVar() && yetki().rol == 'bolge'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['magazalar']);
    }

    match /stores/{magaza} {
      allow read, write: if magazaErisimi(magaza);
    }
    match /stores/{magaza}/{yol=**} {
      allow read, write: if magazaErisimi(magaza);
    }
    match /stores/onur/{yol=**} {
      allow read: if eskiVeriSahibi();
    }

    // Mağaza ayrımından önce köke yazılmış eski veriler: yalnızca okunur.
    match /settings/{belge}     { allow read: if eskiVeriSahibi(); }
    match /entries/{belge}      { allow read: if eskiVeriSahibi(); }
    match /weekgoals/{belge}    { allow read: if eskiVeriSahibi(); }
    match /tools/{belge}        { allow read: if eskiVeriSahibi(); }
    match /ghbhrWeekly/{belge}  { allow read: if eskiVeriSahibi(); }
    match /ghbhrReports/{belge} { allow read: if eskiVeriSahibi(); }
  }
}
