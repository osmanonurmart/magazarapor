rules_version = '2';

// Mağaza Raporu — Firestore güvenlik kuralları
//
// Giriş Firebase Authentication e-posta/şifre ile yapılır:
// kullanıcı adı "m583" → e-posta "m583@mcrapor.app".
// Kimin neye erişeceği yetkiler/{kullaniciAdi} belgesinde durur:
//   { rol: "magaza" }                          — yalnızca stores/{kullaniciAdi}
//   { rol: "bolge", magazalar: ["m583", ...] } — listedeki mağazalar (okur ve düzeltir)
// Mağaza belgesine yonetici: true eklenirse o kullanıcı da ortak araçları düzenler.
// Yetki belgelerini Firebase Console'dan siz açarsınız. Bölge müdürü yalnızca
// kendi belgesindeki "magazalar" listesini değiştirebilir, rolünü değiştiremez.

service cloud.firestore {
  match /databases/{database}/documents {

    function girisli(){
      return request.auth != null && request.auth.token.email is string
          && request.auth.token.email.matches('.+@mcrapor[.]app');
    }
    function kadi(){ return request.auth.token.email.lower().split('@')[0]; }
    function yetkiVar(){ return exists(/databases/$(database)/documents/yetkiler/$(kadi())); }
    function yetki(){ return get(/databases/$(database)/documents/yetkiler/$(kadi())).data; }

    function magazaErisimi(m){
      return girisli() && yetkiVar() && (
        (yetki().rol == 'magaza' && kadi() == m) ||
        (yetki().rol == 'bolge' && yetki().magazalar is list && m in yetki().magazalar)
      );
    }

    // Eski "onur" profilinin verisini m583'e taşımak için yalnızca okuma izni.
    function eskiVeriSahibi(){ return girisli() && kadi() == 'm583'; }

    // Kurucu: uygulamanın sahibi; bütün kullanıcılarla sohbet edebilir.
    function kurucu(){ return girisli() && kadi() == 'm583'; }

    // Yetki belgeleri: kişi kendini, bölge müdürü ve kurucu herkesi okur;
    // mağaza, kendisinin bağlı olduğu bölge müdürünün belgesini okur (sohbet listesi için).
    match /yetkiler/{k} {
      allow read: if girisli() && (k == kadi() || kurucu() || (yetkiVar() && yetki().rol == 'bolge')
                    || ('magazalar' in resource.data && kadi() in resource.data.magazalar));
      allow update: if girisli() && k == kadi() && yetkiVar() && yetki().rol == 'bolge'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['magazalar']);
    }

    // Ortak araçlar ve ortak ayarlar: herkes okur, bölge müdürü ve yönetici yazar.
    function duzenleyici(){
      return girisli() && yetkiVar() && (yetki().rol == 'bolge' || yetki().get('yonetici', false) == true);
    }
    match /araclar/{id} {
      allow read: if girisli() && yetkiVar();
      allow write: if duzenleyici();
    }
    match /ortak/{belge} {
      allow read: if girisli() && yetkiVar();
      allow write: if duzenleyici();
    }

    // Öneri / geri bildirim: herkes kendi adıyla yazar; m583 okur, okundu işaretler ve cevap yazar;
    // gönderen kendi kayıtlarını okur ve cevabı "görüldü" yapar.
    match /geribildirim/{id} {
      allow create: if girisli() && yetkiVar()
                    && request.resource.data.kimden == kadi()
                    && request.resource.data.okundu == false
                    && request.resource.data.metin is string && request.resource.data.metin.size() <= 4000;
      allow read: if girisli() && (kadi() == 'm583' || resource.data.kimden == kadi());
      allow update: if girisli() && (
        (kadi() == 'm583'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['okundu','okunduTarih','cevap','cevapTarih','cevapGoruldu','tasindi']))
        || (resource.data.kimden == kadi()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cevapGoruldu'])));
    }

    // Duyurular: bölge müdürü yazar/siler; listedeki mağazalar okur ve yalnızca kendini "okudu" işaretler.
    match /duyurular/{id} {
      allow create: if girisli() && yetkiVar() && yetki().rol == 'bolge'
                    && request.resource.data.kimden == kadi()
                    && request.resource.data.metin is string && request.resource.data.metin.size() <= 4000;
      allow read: if girisli() && (resource.data.kimden == kadi() || kadi() in resource.data.magazalar);
      allow delete: if girisli() && resource.data.kimden == kadi();
      allow update: if girisli() && kadi() in resource.data.magazalar
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['okuyanlar'])
                    && request.resource.data.okuyanlar.diff(resource.data.okuyanlar).affectedKeys().hasOnly([kadi()]);
    }

    // Sohbet: iki kişilik konuşmalar. Belge adı üyelerin sıralı birleşimidir (ör. "adnanc__m583").
    // İzinli çiftler: herkes ↔ kurucu, bölge müdürü ↔ listesindeki mağaza.
    function sohbetIzinli(u){
      let o = u[0] == kadi() ? u[1] : u[0];
      return kadi() in u && yetkiVar() && (
        kurucu() || o == 'm583'
        || (yetki().rol == 'bolge' && yetki().magazalar is list && o in yetki().magazalar)
        || (yetki().rol == 'magaza'
            && get(/databases/$(database)/documents/yetkiler/$(o)).data.get('magazalar', []) is list
            && kadi() in get(/databases/$(database)/documents/yetkiler/$(o)).data.get('magazalar', [])));
    }
    match /sohbetler/{sid} {
      allow read: if girisli() && kadi() in resource.data.uyeler;
      allow create: if girisli()
                    && request.resource.data.uyeler is list && request.resource.data.uyeler.size() == 2
                    && request.resource.data.uyeler[0] < request.resource.data.uyeler[1]
                    && sid == request.resource.data.uyeler[0] + '__' + request.resource.data.uyeler[1]
                    && sohbetIzinli(request.resource.data.uyeler)
                    && request.resource.data.keys().hasOnly(['uyeler','roller','son','guncelleme','okunma']);
      allow update: if girisli() && kadi() in resource.data.uyeler
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['son','guncelleme','okunma']);

      match /mesajlar/{mid} {
        allow read: if girisli()
                    && kadi() in get(/databases/$(database)/documents/sohbetler/$(sid)).data.uyeler;
        allow create: if girisli()
                    && kadi() in getAfter(/databases/$(database)/documents/sohbetler/$(sid)).data.uyeler
                    && request.resource.data.metin is string
                    && request.resource.data.metin.size() > 0 && request.resource.data.metin.size() <= 4000
                    && request.resource.data.zaman is number
                    && (request.resource.data.kimden == kadi()
                        // Kurucu eski geri bildirimleri gönderenin adıyla taşıyabilir.
                        || (kurucu() && request.resource.data.get('tasima', false) == true
                            && request.resource.data.kimden in getAfter(/databases/$(database)/documents/sohbetler/$(sid)).data.uyeler));
      }
    }

    match /stores/{magaza} {
      allow read, write: if magazaErisimi(magaza);
    }
    match /stores/{magaza}/{yol=**} {
      allow read, write: if magazaErisimi(magaza);
    }
    match /stores/onur/{yol=**} {
      allow read: if eskiVeriSahibi();
    }

    // Mağaza ayrımından önce köke yazılmış eski veriler: yalnızca okunur.
    match /settings/{belge}     { allow read: if eskiVeriSahibi(); }
    match /entries/{belge}      { allow read: if eskiVeriSahibi(); }
    match /weekgoals/{belge}    { allow read: if eskiVeriSahibi(); }
    match /tools/{belge}        { allow read: if eskiVeriSahibi(); }
    match /ghbhrWeekly/{belge}  { allow read: if eskiVeriSahibi(); }
    match /ghbhrReports/{belge} { allow read: if eskiVeriSahibi(); }
  }
}
